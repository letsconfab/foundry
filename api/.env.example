# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/letsconfab

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_BACKEND_REDIRECT_URI=http://localhost:8011/auth/github/callback
GITHUB_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Application Configuration
APP_NAME=Let's Confab API
APP_VERSION=1.0.0
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Default Confab Repository
DEFAULT_CONFAB_REPO_OWNER=letsconfab
DEFAULT_CONFAB_REPO_NAME=confabs

# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=qwen/qwen3-32b

# Foreman Configuration
# V3 (LangGraph) is the canonical implementation and enabled by default.
# Set FOREMAN_V3_ENABLED=false to fall back to legacy Foreman (V1/V2).
# FOREMAN_V2_ENABLED only applies when V3 is disabled.
FOREMAN_V3_ENABLED=true
FOREMAN_V2_ENABLED=false

# Registry GitHub Token (for email/password users without GitHub OAuth)
# This token allows email-login users to commit confabs to letsconfab/registry
# Create a PAT at https://github.com/settings/tokens with 'repo' scope
REGISTRY_GITHUB_TOKEN=
REGISTRY_REPO_OWNER=letsconfab
REGISTRY_REPO_NAME=registry

# Foundry -> Hermes Platform Bridge
# Published confabs deploy as dedicated Hermes profile runtimes and sync knowledge to RAGAnything.
OPENWEBUI_URL=http://localhost:3001
OPENWEBUI_ADMIN_EMAIL=<admin email>
OPENWEBUI_ADMIN_PASSWORD=<admin password>
RAGANYTHING_URL=http://localhost:8001
RAGANYTHING_WORKSPACE_PREFIX=confabs
HERMES_PROFILE_IMAGE=nousresearch/hermes-agent:latest
HERMES_PROFILE_NETWORK=hermes-agents_hermes-net
HERMES_PROFILE_DATA_DIR=./data/hermes-profiles
HERMES_PROFILE_PORT_START=8700
HERMES_PROFILE_PORT_END=8799
HERMES_PROFILE_DASHBOARD_ENABLED=false
HERMES_PROFILE_DASHBOARD_PORT_START=9100
HERMES_PROFILE_DASHBOARD_PORT_END=9199
HERMES_PROFILE_DASHBOARD_CONTAINER_PORT=9119
HERMES_PROFILE_CONTAINER_PREFIX=hermes-confab
HERMES_PROFILE_API_KEY_PREFIX=foundry-confab
HERMES_PLATFORM_PROFILE_SOURCE=/opt/data
# Optional local fallback: copy platform model config/auth from this running Hermes container
# when HERMES_PLATFORM_PROFILE_SOURCE is not readable from the Foundry API host.
HERMES_PLATFORM_PROFILE_CONTAINER=hermes-agent
HERMES_MODEL_ROUTER_URL=http://localhost:8011/router/v1
HERMES_MODEL_ROUTER_API_KEY=<shared router key>
# Use "internal" when the Foundry API router can reach Hermes profile containers on HERMES_PROFILE_NETWORK.
HERMES_MODEL_ROUTER_PROXY_BASE=external
# Deprecated for the profile runtime deploy path.
HERMES_OPENWEBUI_BASE_MODEL=hermes-agent

# Legacy webhook integration. Keep HERMES_WEBHOOK_SECRET only if a webhook
# receiver is intentionally reintroduced.
# HERMES_AGENTS_URL=http://localhost:8022
# HERMES_WEBHOOK_SECRET=
# CONFAB_RAG_URL=http://localhost:8099
