# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost/letsconfab

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_BACKEND_REDIRECT_URI=http://localhost:8001/auth/github/callback
GITHUB_FRONTEND_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Application Configuration
APP_NAME=Let's Confab API
APP_VERSION=1.0.0
DEBUG=True

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Default Confab Repository
DEFAULT_CONFAB_REPO_OWNER=letsconfab
DEFAULT_CONFAB_REPO_NAME=confabs

# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=qwen/qwen3-32b

# Foreman Configuration
# V3 (LangGraph) is the canonical implementation and enabled by default.
# Set FOREMAN_V3_ENABLED=false to fall back to legacy Foreman (V1/V2).
# FOREMAN_V2_ENABLED only applies when V3 is disabled.
FOREMAN_V3_ENABLED=true
FOREMAN_V2_ENABLED=false

# Registry GitHub Token (for email/password users without GitHub OAuth)
# This token allows email-login users to commit confabs to letsconfab/registry
# Create a PAT at https://github.com/settings/tokens with 'repo' scope
REGISTRY_GITHUB_TOKEN=
REGISTRY_REPO_OWNER=letsconfab
REGISTRY_REPO_NAME=registry

# Hermes Agents Integration
# When a confab is published, notify hermes-agents to import the definition
HERMES_AGENTS_URL=http://localhost:8022
HERMES_WEBHOOK_SECRET=
